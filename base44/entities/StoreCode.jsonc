{
  "type": "object",
  "name": "StoreCode",
  "description": "Kode Toko per platform (Shopee, Lazada, Tiktok) beserta nomor rekeningnya",
  "properties": {
    "platform": {
      "type": "string",
      "description": "Platform pemilik kode toko: Shopee, Lazada, Tiktok"
    },
    "code": {
      "type": "string",
      "description": "Kode Toko"
    },
    "account_number": {
      "type": "string",
      "description": "No. Rekening terkait kode toko"
    }
  },
  "required": [
    "platform",
    "code"
  ]
}